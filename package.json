{
  "name": "financial-card-mini-game",
  "version": "3.34.0",
  "description": "金融卡牌小遊戲：金融知識卡牌對決遊戲",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:artifact": "vite build --mode artifact",
    "build:test": "vite build --mode test",
    "test": "vitest run",
    "preview": "vite preview",
    "build:standalone": "vite build --mode standalone && node -e \"const fs=require('fs');fs.cpSync('public/vendor','standalone/vendor',{recursive:true});fs.cpSync('public/licenses','standalone/licenses',{recursive:true})\"",
    "build:all": "vite build && vite build --mode artifact && npm run build:standalone",
    "sim": "vitest run --config vitest.sim.config.js",
    "e2e": "vite build --mode test && playwright test",
    "e2e:ui": "playwright test --ui",
    "test:all": "vitest run && npm run build:all && npm run e2e"
  },
  "devDependencies": {
    "@babel/parser": "^7.26.2",
    "@babel/traverse": "^7.25.9",
    "@playwright/test": "^1.56.0",
    "jsdom": "^25.0.1",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
