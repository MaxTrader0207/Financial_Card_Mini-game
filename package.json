{
  "name": "financial-card-mini-game",
  "version": "4.0.0-alpha.1",
  "description": "金融卡牌小遊戲：金融知識卡牌對決遊戲（Phaser 3 + TypeScript）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "vite build && playwright test",
    "test:all": "npm run typecheck && vitest run && npm run e2e"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.5",
    "jsdom": "^25.0.1",
    "typescript": "5.9.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
